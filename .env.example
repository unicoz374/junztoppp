# ============ PAYMENT GATEWAY AKTIF ============
# isi salah satu: midtrans / transaksikita
PAYMENT_GATEWAY_ACTIVE=midtrans

# ---- Midtrans ----
MIDTRANS_SERVER_KEY=isi-server-key-midtrans
MIDTRANS_CLIENT_KEY=isi-client-key-midtrans
